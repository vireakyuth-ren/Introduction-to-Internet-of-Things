        "z": "da95370b65fedd5b",
        "name": "function 2",
        "func": "msg.measurement = \"bmp280\";\n\nconst d = msg.payload;\n\nconst fields = {\n    gas_raw: Number(d.gas_raw),\n    gas_avg: Number(d.gas_avg),\n    risk_code: Number(d.risk_code),\n    risk_level: String(d.risk_level),\n    fever_flag: Number(d.fever_flag),\n    pressure: Number(d.pressure),\n    altitude: Number(d.altitude),\n    rtc_timestamp: String(d.timestamp)\n};\n\n// body_temp can be null if the MLX90614 read fails.\n// Number(null) would become 0 and show a fake 0 °C reading, so skip it instead.\nif (d.body_temp !== null && d.body_temp !== undefined) {\n    fields.body_temp = Number(d.body_temp);\n}\n\nmsg.payload = fields;\n\nreturn msg;",
